@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "preview:DeleteCommand" as PreviewCommand LOGIC_COLOR
participant "confirmed:DeleteCommand" as ConfirmedCommand LOGIC_COLOR
participant "preview:CommandResult" as PreviewResult LOGIC_COLOR
participant "success:CommandResult" as SuccessResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("delete 1")
activate AddressBookParser
AddressBookParser -> DeleteCommandParser : parse("1")
activate DeleteCommandParser
create PreviewCommand
DeleteCommandParser -> PreviewCommand : new DeleteCommand(index, false)
PreviewCommand --> DeleteCommandParser
DeleteCommandParser --> AddressBookParser : preview
deactivate DeleteCommandParser
AddressBookParser --> LogicManager : preview
deactivate AddressBookParser

LogicManager -> PreviewCommand : execute(m)
activate PreviewCommand
PreviewCommand -> Model : getStudentRoster()
activate Model
Model --> PreviewCommand : roster
deactivate Model
create PreviewResult
PreviewCommand -> PreviewResult : new CommandResult(prompt)
PreviewResult --> PreviewCommand
PreviewCommand --> LogicManager : previewResult
deactivate PreviewCommand
LogicManager -> Model : getStudentRoster()
activate Model
Model --> LogicManager : roster
deactivate Model
LogicManager -> LogicManager : store pending(index, studentId)

[<-- LogicManager : previewResult
deactivate LogicManager

[-> LogicManager : execute("delete 1 /confirm")
activate LogicManager
LogicManager -> LogicManager : consume and clear pending deletion

LogicManager -> AddressBookParser : parseCommand("delete 1 /confirm")
activate AddressBookParser
AddressBookParser -> DeleteCommandParser : parse("1 /confirm")
activate DeleteCommandParser
create ConfirmedCommand
DeleteCommandParser -> ConfirmedCommand : new DeleteCommand(index, true)
ConfirmedCommand --> DeleteCommandParser
DeleteCommandParser --> AddressBookParser : confirmed
deactivate DeleteCommandParser
AddressBookParser --> LogicManager : confirmed
deactivate AddressBookParser

LogicManager -> Model : getStudentRoster()
activate Model
Model --> LogicManager : roster
deactivate Model
LogicManager -> LogicManager : match index and stable studentId
LogicManager -> Model : deleteStudent(studentId)
activate Model
Model --> LogicManager : removedNoteCount
deactivate Model
create SuccessResult
LogicManager -> SuccessResult : new CommandResult(successMessage)
SuccessResult --> LogicManager

[<-- LogicManager : successResult
deactivate LogicManager
@enduml

@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "preview:Command" as PreviewCommand LOGIC_COLOR
participant "confirmed:Command" as ConfirmedCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "s:Storage" as Storage STORAGE_COLOR
end box

note over PreviewCommand, ConfirmedCommand
Each command is a DeleteCommand or
DeleteSessionNoteCommand.
end note

[-> LogicManager : execute("delete ...")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(commandText)
activate AddressBookParser
AddressBookParser -> DeleteCommandParser : parse(arguments)
activate DeleteCommandParser
create PreviewCommand
DeleteCommandParser -> PreviewCommand : new unconfirmed deletion command
PreviewCommand --> DeleteCommandParser : preview
DeleteCommandParser --> AddressBookParser : preview
deactivate DeleteCommandParser
AddressBookParser --> LogicManager : preview
deactivate AddressBookParser

LogicManager -> PreviewCommand : execute(m)
activate PreviewCommand
PreviewCommand -> Model : getStudentRoster()
activate Model
Model --> PreviewCommand : roster
deactivate Model
opt session-note target
    PreviewCommand -> Model : getSessionHistory(studentId)
    activate Model
    Model --> PreviewCommand : history
    deactivate Model
end
PreviewCommand --> LogicManager : preview result
deactivate PreviewCommand

LogicManager -> Model : getStudentRoster()
activate Model
Model --> LogicManager : roster
deactivate Model
alt student target
    LogicManager -> LogicManager : store pending(index, studentId)
else session-note target
    LogicManager -> Model : getSessionHistory(studentId)
    activate Model
    Model --> LogicManager : history
    deactivate Model
    LogicManager -> LogicManager : store pending(index, studentId,\nnoteNumber, history)
end

[<-- LogicManager : preview result
deactivate LogicManager

[-> LogicManager : execute("delete ... /confirm")
activate LogicManager
LogicManager -> LogicManager : consume and clear pending deletion

LogicManager -> AddressBookParser : parseCommand(commandText)
activate AddressBookParser
AddressBookParser -> DeleteCommandParser : parse(arguments)
activate DeleteCommandParser
create ConfirmedCommand
DeleteCommandParser -> ConfirmedCommand : new confirmed deletion command
ConfirmedCommand --> DeleteCommandParser : confirmed
DeleteCommandParser --> AddressBookParser : confirmed
deactivate DeleteCommandParser
AddressBookParser --> LogicManager : confirmed
deactivate AddressBookParser

alt no pending deletion
    [<-- LogicManager : no-pending error
else pending deletion exists
    LogicManager -> Model : getStudentRoster()
    activate Model
    Model --> LogicManager : roster
    deactivate Model
    opt session-note target
        LogicManager -> Model : getSessionHistory(studentId)
        activate Model
        Model --> LogicManager : currentHistory
        deactivate Model
    end

    alt confirmation mismatches target
        [<-- LogicManager : mismatch error
    else confirmation matches target
        LogicManager -> Model : getAddressBook()
        activate Model
        Model --> LogicManager : currentData
        deactivate Model
        LogicManager -> LogicManager : copy currentData as snapshot

        alt student target
            LogicManager -> Model : deleteStudent(studentId)
            activate Model
            Model --> LogicManager : removedNoteCount
            deactivate Model
        else session-note target
            LogicManager -> Model : deleteSessionNote(studentId, noteNumber)
            activate Model
            Model --> LogicManager : removedNote
            deactivate Model
        end

        LogicManager -> Model : getAddressBook()
        activate Model
        Model --> LogicManager : updatedData
        deactivate Model
        LogicManager -> Storage : saveAddressBook(updatedData)
        activate Storage
        alt save succeeds
            Storage --> LogicManager
            [<-- LogicManager : success result
        else save fails
            Storage --> LogicManager : IOException
            LogicManager -> Model : setAddressBook(snapshot)
            activate Model
            Model --> LogicManager
            deactivate Model
            [<-- LogicManager : storage error
        end
        deactivate Storage
    end
end
deactivate LogicManager
@enduml

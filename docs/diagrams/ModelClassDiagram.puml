@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage {
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nModel" as Model
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class AddressBook
Class ModelManager
Class UserPrefs

Class Student
Class StudentId
Class StudentName
Class ParentGuardianContact
Class Subject
Class CurrentLevel
Class StudentSessionHistories
Class SessionHistory
Class SessionNote
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

Model .left.> ReadOnlyAddressBook
Model .right.> ReadOnlyUserPrefs
ModelManager .up.|> Model
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs

AddressBook *--> "*" Student : students
AddressBook *--> "1" StudentSessionHistories

Student *--> "1" StudentId
Student *--> "1" StudentName
Student *--> "1" ParentGuardianContact
Student *--> "1" Subject
Student *--> "1" CurrentLevel

StudentSessionHistories --> "*" SessionHistory
SessionHistory --> "*" SessionNote

Student -[hidden]right- StudentSessionHistories

@enduml

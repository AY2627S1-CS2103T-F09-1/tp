@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Preview and confirm deletion of one session note

actor User as user USER_COLOR
participant ":MainWindow" as window UI_COLOR
participant ":StudentProfilePanel" as profile UI_COLOR
participant ":LogicManager" as logic LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> window : "delete note 1 2"
activate window
window -> logic : execute("delete note 1 2")
activate logic
logic -> model : getStudentRoster()
activate model
model --> logic : roster
deactivate model
logic -> model : getSessionHistory(studentId)
activate model
model --> logic : history
deactivate model
note over logic
  Retain the student ID, note number,
  and history for confirmation.
end note
logic --> window : CommandResult(studentId, noteNumber, prompt)
deactivate logic
window -> logic : getStudentProfile(studentId)
activate logic
logic -> model : getStudentProfile(studentId)
activate model
model --> logic : studentProfile
deactivate model
logic --> window : studentProfile
deactivate logic
window -> profile : setProfile(studentProfile)
activate profile
profile --> window
deactivate profile
window -> profile : previewDeletionOf(noteNumber)
activate profile
profile --> window
deactivate profile
window --> user : highlighted note and confirmation prompt
deactivate window

user -> window : "delete note 1 2 /confirm"
activate window
window -> logic : execute("delete note 1 2 /confirm")
activate logic
note over logic
  Verify the pending target
  still matches.
end note
logic -> model : deleteSessionNote(studentId, noteNumber)
activate model
model --> logic
deactivate model
logic -> storage : saveAddressBook(addressBook)
activate storage
storage --> logic
deactivate storage
logic --> window : success result
deactivate logic
window -> profile : clearDeletionPreview()
activate profile
profile --> window
deactivate profile
window -> logic : getStudentProfile(studentId)
activate logic
logic -> model : getStudentProfile(studentId)
activate model
model --> logic : updatedProfile
deactivate model
logic --> window : updatedProfile
deactivate logic
window -> profile : setProfile(updatedProfile)
activate profile
profile --> window
deactivate profile
window --> user : refreshed notes and success message
deactivate window
@enduml

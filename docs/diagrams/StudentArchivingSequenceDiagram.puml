@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:ArchiveCommand" as ArchiveCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("archive 2")
activate LogicManager

LogicManager -> ArchiveCommand : execute(model)
activate ArchiveCommand

ArchiveCommand -> Model : getStudentRoster()
activate Model
Model --> ArchiveCommand : roster
deactivate Model

ArchiveCommand -> Model : archiveStudent(studentId)
activate Model
Model --> ArchiveCommand
deactivate Model

ArchiveCommand --> LogicManager : result
deactivate ArchiveCommand

LogicManager -> Storage : saveAddressBook(addressBook)
activate Storage
Storage --> LogicManager
deactivate Storage

[<-- LogicManager : result
deactivate LogicManager
@enduml

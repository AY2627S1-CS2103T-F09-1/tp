@startuml
skin rose
!pragma useVerticalIf on
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:Split input into command word
and arguments;
if () then ([input is blank])
    :Report empty command
    and list commands;
    stop
elseif () then ([command word is known])
    :Create the command, through
    its parser if it takes arguments;
    stop
elseif () then ([known when case is ignored])
    :Report that the command word
    must be lowercase;
    stop
else ([else])
endif
:Report unknown command
and list commands;
stop
@enduml

@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:AddCommand" as AddCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("add ...")
activate LogicManager

create AddCommand
ref over LogicManager, AddCommand : Parse add command

LogicManager -> AddCommand : execute(model)
activate AddCommand

AddCommand -> Model : hasStudent(student)
activate Model
Model --> AddCommand : false
deactivate Model

AddCommand -> Model : addStudent(student)
activate Model
Model --> AddCommand
deactivate Model

AddCommand --> LogicManager : result
deactivate AddCommand

LogicManager -> Storage : saveAddressBook(addressBook)
activate Storage
Storage --> LogicManager
deactivate Storage

[<-- LogicManager : result
deactivate LogicManager
@enduml

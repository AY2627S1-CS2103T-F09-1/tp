@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {

package "Parser classes" as ParserClasses{
}
Class "<<interface>>\nLogic" as Logic
Class LogicManager
Class "{abstract}\nCommand" as Command
Class XYZCommand
Class CommandResult
}

package Storage {
}

package Model {
Class HiddenModel #FFFFFF
}

LogicManager .up.|> Logic
LogicManager -right-> "1" ParserClasses
LogicManager -left-> Storage
LogicManager --> Model
Storage -[hidden]down- Model
LogicManager .down.> Command : <<call>>

ParserClasses .down.> XYZCommand : <<create>>
XYZCommand -right-|> Command
Command .left.> Model
Command .down.> CommandResult : <<create>>

note bottom of XYZCommand
XYZCommand = AddCommand,
NoteCommand, etc
end note
@enduml

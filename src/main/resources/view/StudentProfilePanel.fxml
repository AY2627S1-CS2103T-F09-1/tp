<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import seedu.address.ui.SelectableText?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           minWidth="0" styleClass="student-profile-panel">
  <VBox fx:id="emptyState" alignment="CENTER" spacing="8" styleClass="profile-empty-state">
    <SelectableText text="No student selected" maxWidth="280" styleClass="empty-state-title" />
    <SelectableText text="Use view INDEX to open a student profile." maxWidth="280"
                    styleClass="empty-state-guidance" />
  </VBox>

  <VBox fx:id="profileContent" maxWidth="Infinity" minWidth="0" spacing="18"
        styleClass="profile-content" visible="false" managed="false">
    <SelectableText fx:id="studentName" maxWidth="Infinity" styleClass="profile-name" />
    <GridPane hgap="14" maxWidth="Infinity" minWidth="0" styleClass="profile-details" vgap="12">
      <columnConstraints>
        <ColumnConstraints minWidth="112" prefWidth="145" maxWidth="170" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="0" />
      </columnConstraints>
      <SelectableText text="Parent/guardian phone" styleClass="profile-field-label" GridPane.columnIndex="0"
                      GridPane.rowIndex="0" />
      <SelectableText fx:id="parentGuardianPhone" maxWidth="Infinity" styleClass="profile-field-value"
                      GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <SelectableText text="Parent/guardian email" styleClass="profile-field-label" GridPane.columnIndex="0"
                      GridPane.rowIndex="1" />
      <SelectableText fx:id="parentGuardianEmail" maxWidth="Infinity" styleClass="profile-field-value"
                      GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <SelectableText text="Subject" styleClass="profile-field-label" GridPane.columnIndex="0"
                      GridPane.rowIndex="2" />
      <SelectableText fx:id="subject" maxWidth="Infinity" styleClass="profile-field-value"
                      GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <SelectableText text="Current level" styleClass="profile-field-label" GridPane.columnIndex="0"
                      GridPane.rowIndex="3" />
      <SelectableText fx:id="currentLevel" maxWidth="Infinity" styleClass="profile-field-value"
                      GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>
    <SelectableText text="Session notes" styleClass="profile-section-heading" />
    <StackPane minWidth="0" VBox.vgrow="ALWAYS">
      <ListView fx:id="sessionNoteListView" styleClass="session-note-list" />
      <VBox fx:id="emptyNotesState" alignment="CENTER" maxWidth="Infinity" spacing="5"
            styleClass="empty-notes-state" visible="false" managed="false">
        <SelectableText text="No session notes yet" styleClass="empty-notes-title" />
        <SelectableText text="Use note INDEX nt/NOTE to record the first lesson update."
                        styleClass="empty-state-guidance" />
      </VBox>
    </StackPane>
    <padding>
      <Insets top="20" right="20" bottom="20" left="20" />
    </padding>
  </VBox>
</StackPane>

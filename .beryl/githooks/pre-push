#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
  exit 0
fi

# Git passes the remote name (or URL) as the first argument. Protect that
# remote's default branch, e.g. master, instead of assuming it is main.
remote_name="${1:-}"
default_ref=""
if [[ -n "${remote_name}" ]]; then
  remote_head="$(git symbolic-ref --quiet "refs/remotes/${remote_name}/HEAD" 2>/dev/null || true)"
  if [[ -n "${remote_head}" ]]; then
    default_ref="refs/heads/${remote_head#"refs/remotes/${remote_name}/"}"
  fi
fi

is_default_branch() {
  local ref="$1"
  if [[ -n "${default_ref}" ]]; then
    [[ "${ref}" == "${default_ref}" ]]
  else
    # The remote's default branch is unknown, e.g. when pushing to a URL.
    [[ "${ref}" == "refs/heads/main" || "${ref}" == "refs/heads/master" ]]
  fi
}

pushes_default=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if is_default_branch "${remote_ref}"; then
    pushes_default=1
    break
  fi
done

if [[ "${pushes_default}" == "1" ]]; then
  CHECK_AFFECTED_MODE=worktree "${REPO_ROOT}/.beryl/scripts/check.sh"
else
  printf "pre-push: default branch not targeted; skipping slow checks\n"
fi
